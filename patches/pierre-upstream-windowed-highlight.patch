+  /**
+   * Honor `startingLine`/`totalLines` while still syntax highlighting, instead
+   * of ignoring them and rendering the whole diff. Rendering a window in
+   * isolation would normally mis-color anything inside a construct that opened
+   * earlier in the file, so a caller that sets this must feed each window's
+   * returned `grammarState` into the next one.
+   *
+   * Only valid when consecutive windows cover the file contiguously: pass
+   * `expandedHunks: true` so no context is skipped, and do not use this on a
+   * partial diff, whose lines are not contiguous in the real file.
+   */
+  windowedHighlight?: boolean;
+  /** Grammar state returned by the previous window's render. Omit for the
+   * first window. Ignored unless `windowedHighlight` is set. */
+  grammarState?: DiffGrammarState;
 }
 
 export interface ForceFilePlainTextOptions {

---
// The count comes from Hunk's own catalog so the "more" pill can never drift
// from what ships. The module is a bare id array with no imports, so reaching
// across into the app costs the site build nothing.
import { BUNDLED_SHIKI_THEME_IDS } from "../../../../src/core/theme/catalog";

/**
 * The picker's spread of the bundled catalog: one neutral default, the popular
 * community palettes, a warm one, and a light one. `id` must stay in step with
 * `HERO_SHOT_THEMES` in website/scripts/capture-media.ts, which photographs
 * exactly these.
 */
const themes = [
  { name: "GitHub Dark", src: "/shot-github-dark.webp" },
  { name: "Tokyo Night", src: "/shot-tokyo-night.webp" },
  { name: "Catppuccin Mocha", src: "/shot-catppuccin-mocha.webp" },
  { name: "Gruvbox", src: "/shot-gruvbox.webp" },
  { name: "Nord", src: "/shot-nord.webp" },
  { name: "GitHub Light", src: "/shot-github-light.webp" },
];

const remainingThemes = BUNDLED_SHIKI_THEME_IDS.length - themes.length;
---

<figure class="frame">
  <div class="paper-bar">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="pt">hunk diff — split view</span>
  </div>
  <div class="shot-stack">
    {
      themes.map((theme, index) => (
        <img
          id={`theme-shot-${index}`}
          class="shot"
          src={index === 0 ? theme.src : undefined}
          data-src={theme.src}
          alt={`Hunk split-view diff in the ${theme.name} theme`}
          width="2202"
          height="1400"
          draggable="false"
          hidden={index !== 0}
        />
      ))
    }
  </div>
</figure>
<div class="themes" role="group" aria-label="Preview theme">
  {
    themes.map((theme, index) => (
      <button
        type="button"
        class:list={["tpill", { on: index === 0 }]}
        aria-pressed={index === 0 ? "true" : "false"}
        aria-controls={`theme-shot-${index}`}
        data-theme-index={index}
      >
        {theme.name}
      </button>
    ))
  }
  <a class="tmore" href="/docs/configure/themes/">and {remainingThemes} more</a>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-index]");
  const shots = document.querySelectorAll<HTMLImageElement>(".shot-stack .shot");

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const selectedIndex = Number(button.dataset.themeIndex);

      buttons.forEach((candidate, index) => {
        const selected = index === selectedIndex;
        candidate.classList.toggle("on", selected);
        candidate.setAttribute("aria-pressed", String(selected));
      });
      shots.forEach((shot, index) => {
        const selected = index === selectedIndex;
        if (selected && !shot.hasAttribute("src") && shot.dataset.src) shot.src = shot.dataset.src;
        shot.hidden = !selected;
      });
    });
  }
</script>

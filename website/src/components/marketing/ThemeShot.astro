---
// The count comes from Hunk's own catalog so the "more" pill can never drift
// from what ships. The module is a bare id array with no imports, so reaching
// across into the app costs the site build nothing.
import { BUNDLED_SHIKI_THEME_IDS } from "../../../../packages/hunk/src/core/theme/catalog";

/**
 * The picker's spread of the bundled catalog: one neutral default, the popular
 * community palettes, a warm one, and a light one. `id` must stay in step with
 * `HERO_SHOT_THEMES` in website/scripts/capture-media.ts, which photographs
 * exactly these.
 */
const themes = [
  { name: "GitHub Dark", src: "/shot-github-dark.webp" },
  { name: "Tokyo Night", src: "/shot-tokyo-night.webp" },
  { name: "Catppuccin Mocha", src: "/shot-catppuccin-mocha.webp" },
  { name: "Gruvbox", src: "/shot-gruvbox.webp" },
  { name: "Nord", src: "/shot-nord.webp" },
  { name: "GitHub Light", src: "/shot-github-light.webp" },
];

const remainingThemes = BUNDLED_SHIKI_THEME_IDS.length - themes.length;
---

<figure class="frame">
  <div class="paper-bar">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="pt">hunk diff — split view</span>
  </div>
  <div class="shot-stack">
    {
      themes.map((theme, index) => (
        <img
          id={`theme-shot-${index}`}
          class="shot"
          src={index === 0 ? theme.src : undefined}
          data-src={theme.src}
          alt={`Hunk split-view diff in the ${theme.name} theme`}
          width="2202"
          height="1400"
          draggable="false"
          hidden={index !== 0}
        />
      ))
    }
  </div>
</figure>
<div class="themes" role="group" aria-label="Preview theme">
  {
    themes.map((theme, index) => (
      <button
        type="button"
        class:list={["tpill", { on: index === 0 }]}
        aria-pressed={index === 0 ? "true" : "false"}
        aria-controls={`theme-shot-${index}`}
        data-theme-index={index}
      >
        {theme.name}
      </button>
    ))
  }
  <a class="tmore" href="/docs/configure/themes/">and {remainingThemes} more</a>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-index]");
  const shots = document.querySelectorAll<HTMLImageElement>(".shot-stack .shot");

  /**
   * Give one shot its real source, once, and decode it up front so switching
   * to it is a paint rather than a fetch.
   */
  const warm = (shot: HTMLImageElement | undefined) => {
    if (!shot || shot.hasAttribute("src") || !shot.dataset.src) {
      return;
    }
    shot.src = shot.dataset.src;
    void shot.decode().catch(() => {
      // A refused decode only means the swap pays for it later.
    });
  };

  // The document ships the selected shot alone, so first paint never waits on
  // the ~1.4MB behind the other pills. Warm those once loading is done and the
  // browser is idle, which is long before anyone reaches for a pill.
  const warmAll = () => {
    for (const shot of shots) {
      warm(shot);
    }
  };
  const scheduleWarm = () => {
    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(warmAll, { timeout: 2000 });
    } else {
      window.setTimeout(warmAll, 300);
    }
  };

  if (document.readyState === "complete") {
    scheduleWarm();
  } else {
    window.addEventListener("load", scheduleWarm, { once: true });
  }

  for (const button of buttons) {
    const buttonIndex = Number(button.dataset.themeIndex);

    // A pointer or keyboard focus landing on a pill beats the idle pass as a
    // signal, so warm that shot right away rather than waiting its turn.
    const warmOwnShot = () => warm(shots[buttonIndex]);
    button.addEventListener("pointerenter", warmOwnShot);
    button.addEventListener("focus", warmOwnShot);

    button.addEventListener("click", () => {
      buttons.forEach((candidate, index) => {
        const selected = index === buttonIndex;
        candidate.classList.toggle("on", selected);
        candidate.setAttribute("aria-pressed", String(selected));
      });
      shots.forEach((shot, index) => {
        const selected = index === buttonIndex;
        if (selected) {
          warm(shot);
        }
        shot.hidden = !selected;
      });
    });
  }
</script>

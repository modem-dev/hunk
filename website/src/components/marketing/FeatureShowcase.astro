---
/**
 * Media-led feature sections captured from the real TUI.
 *
 * Every clip and still is generated by `website/scripts/capture-media.ts`,
 * which drives Hunk from source in a PTY and renders retina frames — nothing
 * here is a mockup. Clips autoplay muted as a baseline; the inline script
 * pauses them off-screen and honors reduced-motion.
 */
interface ShowcaseVideo {
  kind: "video";
  base: string;
  width: number;
  height: number;
  label: string;
}

interface ShowcaseImage {
  kind: "image";
  src: string;
  width: number;
  height: number;
  alt: string;
}

/**
 * A source sample in the same framed chrome as the captures. The highlight
 * spans are hand-authored so the landing page ships no highlighter script,
 * and the title bar carries the path the file actually lives at.
 */
interface ShowcaseCode {
  kind: "code";
  file: string;
  source: string;
  label: string;
}

interface ShowcaseFeature {
  kind: "feature";
  heading: string;
  body: string;
  href: string;
  linkText: string;
  media: ShowcaseVideo | ShowcaseImage | ShowcaseCode;
}

/** Keep in sync with the hello-world example in docs/extend/extensions. */
const extensionSample = [
  `<span class="k">import type</span> { HunkExtensionAPI } <span class="k">from</span> <span class="s">"hunkdiff/extension"</span>;`,
  ``,
  `<span class="k">export default function</span> (hunk: HunkExtensionAPI) {`,
  `  hunk.registerCommand(`,
  `    { id: <span class="s">"hello"</span>, title: <span class="s">"Say hello"</span>, key: <span class="s">"f6"</span> },`,
  `    (ctx) =&gt; ctx.notify(<span class="s">"Hello from my extension"</span>),`,
  `  );`,
  `}`,
].join("\n");

/** A pull-quote breather between feature rows, linked to the original post. */
interface ShowcaseQuote {
  kind: "quote";
  quote: string;
  who: string;
  href: string;
}

/**
 * The tour interleaves quotes as beats between chapters: Mitchell's after the
 * reviewing story (stream + agent notes), DHH's before the closing rows on
 * making Hunk your own — themes, then extensions.
 */
const showcase: (ShowcaseFeature | ShowcaseQuote)[] = [
  {
    kind: "feature",
    heading: "One stream, every file.",
    body: "The whole changeset reads top to bottom in sidebar order — no flipping between single-file views. File counts at a glance, hunk jumps with [ and ], and the sidebar takes you straight to any file.",
    href: "/docs/workflows/working-trees-and-commits/",
    linkText: "How reviews work",
    media: {
      kind: "image",
      src: "/feature-stream.webp",
      width: 2084,
      height: 1280,
      alt: "Hunk's multi-file review stream: a sidebar lists changed files while the main pane shows consecutive file diffs top to bottom",
    },
  },
  {
    kind: "feature",
    heading: "Your agent's reasoning, beside the code it explains.",
    body: "Agents leave notes in a sidecar; hunk renders each one inside the diff, right above the hunk it annotates — summary, rationale, and author. Step through hunks with [ and ] and the notes follow.",
    href: "/docs/agents/comments-and-annotations/",
    linkText: "Agent annotations, in depth",
    media: {
      kind: "video",
      base: "feature-agent",
      width: 1480,
      height: 960,
      label: "Agent notes rendered inline in a Hunk review: authored note cards with summary and rationale sit directly above the hunks they annotate, following hunk navigation",
    },
  },
  {
    kind: "quote",
    quote: "Hunk is very good. It has replaced any other local diff viewer for me.",
    who: "Mitchell Hashimoto, creator of Ghostty & Vagrant",
    href: "https://x.com/mitchellh/status/2052128048288567617",
  },
  {
    kind: "feature",
    heading: "Keys when you're fast, mouse when you're browsing.",
    body: "Click a file in the sidebar to jump, wheel-scroll the stream, hover a row to leave a note — or never leave the keyboard. Pipe patches straight in and hunk is your pager, too.",
    href: "/docs/start/keyboard-and-mouse/",
    linkText: "Keyboard & mouse reference",
    media: {
      kind: "video",
      base: "feature-mouse",
      width: 1984,
      height: 1200,
      label: "Mouse support in Hunk: clicking a sidebar file jumps the review stream to it, wheel scrolling moves through the diff, and hovering a changed row reveals the add-note control",
    },
  },
  {
    kind: "feature",
    heading: "Split or unified — or let auto decide.",
    body: "Side-by-side when your terminal is wide, unified when it's narrow. Auto picks for you; press 1, 2, or 0 to override at any time, with wrapping and line numbers toggled live.",
    href: "/docs/configure/layout-and-display/",
    linkText: "Layout & display options",
    media: {
      kind: "video",
      base: "feature-layout",
      width: 1816,
      height: 1200,
      label: "The same diff flipping between Hunk's side-by-side split layout and its unified layout",
    },
  },
  {
    kind: "quote",
    quote: "Love hunk.",
    who: "DHH, creator of Omarchy and Ruby on Rails",
    href: "https://x.com/dhh/status/2062919431680852164",
  },
  {
    kind: "feature",
    heading: "Real syntax highlighting. Dozens of themes.",
    body: "Understand structure, not just added and removed lines. Ships with its own looks plus the classics — Catppuccin, Dracula, Gruvbox, GitHub, and more — or roll your own in config.",
    href: "/docs/configure/themes/",
    linkText: "Theme gallery & config",
    media: {
      kind: "video",
      base: "feature-themes",
      width: 1816,
      height: 1200,
      label: "One split diff crossfading through Hunk themes including Midnight, Dracula, Catppuccin Mocha, Gruvbox, and GitHub Light",
    },
  },
  {
    kind: "feature",
    heading: "Extend it however you want.",
    body: "Add a theme, a command, a new way to preview a file, a docked pane, or a whole version-control backend. Extensions are plain TypeScript, and you can install one from any git repository.",
    href: "/docs/extend/extensions/",
    linkText: "Writing extensions",
    media: {
      kind: "code",
      file: "~/.config/hunk/extensions/hello.ts",
      source: extensionSample,
      label: "A complete Hunk extension: a TypeScript file that registers a command bound to f6",
    },
  },
];
---

<div class="show">
  {
    showcase.map((item) =>
      item.kind === "quote" ? (
        <figure class="show-quote">
          <span class="qmark" aria-hidden="true">“</span>
          <blockquote>{item.quote}</blockquote>
          <figcaption>
            <a href={item.href} target="_blank" rel="noopener noreferrer">
              {item.who}
            </a>
          </figcaption>
        </figure>
      ) : (
        <article class="show-item">
          <div class="show-copy">
            <h3>{item.heading}</h3>
            <p>{item.body}</p>
            <a class="more" href={item.href}>
              {item.linkText} →
            </a>
          </div>
          <figure class:list={["show-media", item.media.kind === "code" && "show-code"]}>
            {item.media.kind === "code" ? (
              <Fragment>
                <div class="paper-bar">
                  <span class="dot" />
                  <span class="dot" />
                  <span class="dot" />
                  <span class="pt">{item.media.file}</span>
                </div>
                {/* Focusable because the sample scrolls sideways on narrow screens.
                    Kept on one line: pre preserves the source formatting verbatim. */}
                {/* prettier-ignore */}
                <pre tabindex="0" aria-label={item.media.label}><code set:html={item.media.source} /></pre>
              </Fragment>
            ) : item.media.kind === "image" ? (
              <img
                src={item.media.src}
                width={item.media.width}
                height={item.media.height}
                alt={item.media.alt}
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            ) : (
              <video
                width={item.media.width}
                height={item.media.height}
                loop
                muted
                playsinline
                preload="metadata"
                aria-label={item.media.label}
              >
                <source src={`/${item.media.base}.webm`} type="video/webm" />
                <source src={`/${item.media.base}.mp4`} type="video/mp4" />
              </video>
            )}
          </figure>
        </article>
      ),
    )
  }
</div>

<script>
  // Playback is script-driven — no native autoplay — so a reduced-motion
  // preference is honored from first paint, not after a visible flicker.
  // Without JavaScript the clips stay on their preloaded first frame.
  const clips = Array.from(document.querySelectorAll<HTMLVideoElement>(".show-media video"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const visibleClips = new WeakSet<HTMLVideoElement>();

  const syncPlayback = (clip: HTMLVideoElement) => {
    if (reducedMotion.matches || !visibleClips.has(clip)) {
      clip.pause();
    } else {
      void clip.play().catch(() => {
        // Autoplay restrictions leave the first frame showing, which is fine.
      });
    }
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const clip = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          visibleClips.add(clip);
        } else {
          visibleClips.delete(clip);
        }
        syncPlayback(clip);
      }
    },
    { rootMargin: "120px" },
  );

  for (const clip of clips) {
    observer.observe(clip);
  }
  reducedMotion.addEventListener("change", () => {
    for (const clip of clips) {
      syncPlayback(clip);
    }
  });
</script>

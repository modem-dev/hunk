+    count: frozen.length,
+    files: frozen.map((entry) => ({ path: entry.path, sha256: entry.sha256 })),
+    behavioralTestContinuity: {
+      control: controlContracts,
+      treatment: currentContracts,
+      note: "Mechanical anti-weakening evidence only; independent review must establish behavioral preservation.",

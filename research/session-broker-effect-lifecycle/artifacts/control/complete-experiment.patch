+function parseTestCounts(stdout: string, stderr: string) {
+  const text = `${stdout}\n${stderr}`;
+  const counts: Record<string, number> = {};
+  const patterns = {
+    passed: [
+      /(?:^|\n)\s*(\d+) pass(?:ed)?\b/m,
+      /(?:^|\n)# pass (\d+)\b/m,
+      /(?:^|\n)ℹ pass (\d+)\b/m,
+    ],
+    failed: [
+      /(?:^|\n)\s*(\d+) fail(?:ed)?\b/m,
+      /(?:^|\n)# fail (\d+)\b/m,
+      /(?:^|\n)ℹ fail (\d+)\b/m,
+    ],
+    skipped: [
+      /(?:^|\n)\s*(\d+) skip(?:ped)?\b/m,
+      /(?:^|\n)# skipped (\d+)\b/m,
+      /(?:^|\n)ℹ skipped (\d+)\b/m,
+    ],
+  };
+  let ambiguous = false;
+  for (const [name, candidates] of Object.entries(patterns)) {
+    const matches = candidates.flatMap((pattern) => [
+      ...text.matchAll(new RegExp(pattern.source, "gm")),
+    ]);
+    if (matches.length > 1) ambiguous = true;
+    if (matches.length === 1 && matches[0]?.[1]) counts[name] = Number(matches[0][1]);
+  }
+  return !ambiguous && counts.passed !== undefined ? counts : undefined;
+}

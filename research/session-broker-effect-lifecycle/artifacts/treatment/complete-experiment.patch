+  }
+
+  const bunRuntimeFixture = await buildBunRuntimeFixture(root, outputRoot);
+  const defectMessages: string[] = [];
+  const lifecycle = createArmLifecycle(label, (message) => defectMessages.push(message));
+  const measurements: Record<string, Measurement> = {
+    processToLifecycleReadyCold: await measureColdLifecycleReady(

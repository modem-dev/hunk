+function percentile(samples: readonly number[], fraction: number) {
+  const sorted = [...samples].sort((left, right) => left - right);
+  return sorted[Math.max(0, Math.ceil(sorted.length * fraction) - 1)] ?? 0;
+}
+
+/** Measure one stable local operation with frozen warmup and sample counts. */
+async function measure(operation: () => void | Promise<void>): Promise<SampleSeries> {

+    recordedAt: new Date().toISOString(),
+    environment: {
+      head: sourceIdentity.currentHead,
+      bun: Bun.version,
+      embeddedNode: process.versions.node,
+      systemNodeTranscript: systemNode.stdoutTranscript,
+      os: platform(),
+      release: release(),
+      arch: arch(),
+      cpu: cpus()[0]?.model ?? "unknown",
+    },
+    identities: {

+    measurements,
+    coarseObservations: {
+      cpu,
+      rss: {
+        classification: "coarse-non-isolated-observation",
+        conclusionPolicy:
+          "Do not infer lifecycle performance or security conclusions from this sample.",
+        unit: "bytes",
+        samples: rssSamples,

+  await writeJson(join(outputRoot, "result.json"), result);
+
+  const canaryMatches = await scanCanary(outputRoot, canaryMarker);
+  if (canaryMatches.length > 0) {
+    throw new Error(`Canary marker escaped into evidence: ${canaryMatches.join(", ")}`);
+  }
+  await writeManifest(outputRoot);
+  console.log(join(outputRoot, "result.json"));
+}

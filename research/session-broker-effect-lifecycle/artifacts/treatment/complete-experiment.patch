+  const declarationFiles = (await listFiles(declarationRoot)).filter((path) =>
+    path.endsWith(".d.ts"),
+  );
+  const forbiddenDeclarationPattern =
+    /(?:from\s+["']effect["']|\b(?:Effect|ManagedRuntime|Runtime|Layer|Scope|Fiber|Cause|Exit|Duration|Schedule|Clock)\b)/;
+  const declarationMatches: Array<{ file: string; line: number; text: string }> = [];
+  for (const path of declarationFiles) {
+    const lines = (await readFile(path, "utf8")).split("\n");
+    lines.forEach((text, index) => {
+      const declarationText = /^\s*(?:\/\*|\*|\/\/)/.test(text) ? "" : text;
+      if (forbiddenDeclarationPattern.test(declarationText)) {
+        declarationMatches.push({ file: relative(declarationRoot, path), line: index + 1, text });
+      }
+    });

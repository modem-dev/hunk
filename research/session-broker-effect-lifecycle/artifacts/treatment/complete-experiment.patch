+      reason:
+        "Hunk startup polling is a Bun product path with no honest portable real-Node equivalent; characterization tests freeze behavior instead of timing a synthetic timer.",
+    },
+  };
+
+  const cpuBefore = process.cpuUsage();
+  const cpuStartedAt = performance.now();
+  for (let index = 0; index < 100; index += 1) await measureCommand(lifecycle);
+  const cpu = {
+    classification: "coarse-non-isolated-observation",
+    conclusionPolicy:

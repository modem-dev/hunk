+  const dependencyPlacement = await collectDependencyPlacement(root, label, effectVersions);
+  if (label === "treatment" && dependencyTree.exitCode !== 0) {
+    throw new Error("Treatment dependency-tree command must exit successfully.");
+  }
+  const moduleBoundaries = collectModuleBoundaries(root, label);
+
+  const builds = [];
+  for (let index = 1; index <= 3; index += 1) {
+    builds.push(await buildBrokerBundle(root, buildRoot, "bun", index));
+    builds.push(await buildBrokerBundle(root, buildRoot, "node", index));
+  }
+  for (let index = 1; index <= 3; index += 1) {

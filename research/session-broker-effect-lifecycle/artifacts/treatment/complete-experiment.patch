+    relative(root, declarationRoot),
+    "--module",
+    "ESNext",
+    "--moduleResolution",
+    "Bundler",
+    "--target",
+    "ES2022",
+    "--lib",
+    "ES2022,DOM",
+    "--skipLibCheck",
+    "--strict",
+    "--types",
+    "bun",
+  ]);

{
  "name": "@hunk/vcs",
  "version": "0.0.0",
  "private": true,
  "description": "Private shared utilities for Hunk bundled VCS providers",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./diff-range": {
      "types": "./src/diffRange.ts",
      "import": "./src/diffRange.ts"
    },
    "./large-file": {
      "types": "./src/largeFile.ts",
      "import": "./src/largeFile.ts"
    },
    "./os-path": {
      "types": "./src/osPath.ts",
      "import": "./src/osPath.ts"
    },
    "./source-text": {
      "types": "./src/sourceText.ts",
      "import": "./src/sourceText.ts"
    }
  },
  "devDependencies": {
    "hunkdiff": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22"
  }
}
